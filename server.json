{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/releaseguard",
  "description": "Scans datasets/models for PII/secrets, redacts, and packages a public-release bundle via MCP.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/ReleaseGuard",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "releaseguard-cli",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "releaseguard-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "releaseguard"
        },
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
